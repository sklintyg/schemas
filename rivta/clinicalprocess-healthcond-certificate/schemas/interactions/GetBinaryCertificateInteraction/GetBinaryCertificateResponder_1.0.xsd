<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="urn:riv:clinicalprocess:healthcond:certificate:GetBinaryCertificateResponder:1"
	xmlns:tns="urn:riv:clinicalprocess:healthcond:certificate:GetBinaryCertificateResponder:1"
	xmlns:types="urn:riv:clinicalprocess:healthcond:certificate:types:3"
	xmlns:core="urn:riv:clinicalprocess:healthcond:certificate:3"
	elementFormDefault="qualified" attributeFormDefault="unqualified"
	version="1.0">

	<import namespace="urn:riv:clinicalprocess:healthcond:certificate:3"
		schemaLocation="../../core_components/clinicalprocess_healthcond_certificate_3.3.xsd" />
	<import namespace="urn:riv:clinicalprocess:healthcond:certificate:3.2"
		schemaLocation="../../core_components/clinicalprocess_healthcond_certificate_3.2_ext.xsd" />
	<import namespace="urn:riv:clinicalprocess:healthcond:certificate:types:3"
		schemaLocation="../../core_components/clinicalprocess_healthcond_certificate_types_3.2.xsd" />

	<element name="GetBinaryCertificate" type="tns:GetBinaryCertificateType" />
	<element name="GetBinaryCertificateResponse" type="tns:GetBinaryCertificateResponseType" />

	<complexType name="GetBinaryCertificateType">
		<sequence>
			<element name="intygs-id" type="types:IntygId" />
			<any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded" />
		</sequence>
	</complexType>

	<complexType name="GetBinaryCertificateResponseType">
		<sequence>
			<!-- Ett intyg i binärt format -->
			<element name="binartIntyg" type="tns:BinartIntyg" minOccurs="0" />
			<any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded" />
		</sequence>
	</complexType>

	<!-- Ett intyg i binärt format -->
	<complexType name="BinartIntyg">
		<sequence>
			<!-- Unik identifierare för intyget -->
			<element name="intygs-id" type="types:IntygId" />
			<!-- Typ av intyg -->
			<element name="typ" type="types:TypAvIntyg" />
			<!-- Versionsangivelse för typ av intyg -->
			<element name="version" type="string" />
			<!-- Tidpunkt då intyget signerades -->
			<element name="signeringstidpunkt" type="types:TimeStampType" minOccurs="0" />
			<!-- Patient som intyget avser -->
			<element name="patient" type="core:Patient" />
			<!-- Hälso- och sjukvårdspersonal som utfärdat intyget -->
			<element name="skapadAv" type="core:HosPersonal" />
			<!-- Relation till andra intyg -->
			<element name="relation" type="core:Relation" minOccurs="0" maxOccurs="unbounded" />
			<!-- Statusar som är satta för intyget. Giltiga värden: 
			 RECEIV (mottaget av Intygstjänsten/signerat i vårdsystemet), 
			 SENTTO (skickat till mottagare), CANCEL (makulerat), 
			 DELETE (arkiverat av invånaren i Mina intyg), 
			 RESTOR (återställt från arkivering i Mina intyg) -->
			<element name="status" type="core:IntygsStatus" minOccurs="0" maxOccurs="unbounded" />
			<!-- Svar på frågor i intyget i binärt format -->
			<element name="binartSvar" type="tns:BinaryDataType" minOccurs="0" />
			<any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded" />
		</sequence>
	</complexType>

	<!-- Binärdata -->
	<complexType name="BinaryDataType">
		<sequence>
			<!-- MIME-typ för binärdata, t.ex. application/pdf för PDF -->
			<element name="contentType" type="token" />
			<!-- Binärdata (base64-kodad) -->
			<element name="data" type="base64Binary" />
			<any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded" />
		</sequence>
	</complexType>

</schema>
